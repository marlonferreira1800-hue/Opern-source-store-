{
  "version": 1,
  "description": "Política oficial de curadoria, segurança e qualidade da Open Source Store (5 Portões).",
  "thresholds": {
    "curated": {
      "target_count": 100,
      "min_stars": 3000,
      "min_repo_age_days": 180,
      "min_owner_age_days": 365,
      "min_release_downloads": 5000,
      "min_release_count": 3,
      "max_inactive_push_days": 180,
      "max_inactive_release_days": 365,
      "max_per_category": 24,
      "require_windows_asset": true
    },
    "live_search": {
      "min_stars": 1000,
      "min_repo_age_days": 90,
      "min_release_downloads": 500,
      "grace_new_release_days": 14,
      "max_inactive_push_days": 365,
      "max_inactive_release_days": 730
    }
  },
