{
  "package": {
    "name": "Open Source Store",
    "version": "0.1.0",
    "description": "A Play Store for open source applications",
    "authors": ["Marlon Ferreira"],
    "license": "MIT",
    "repository": "https://github.com/marlonferreira1800-hue/Open-Source-Store",
    "default": true
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": true,
        "scope": [
          {
            "name": "Open Shell",
            "description": "Allows opening URLs in the default browser"
          }
        ]
      },
      "http": {
        "all": true,
        "scope": [
          {
            "name": "Download Apps",
            "description": "Allows downloading APK files from GitHub",
            "domains": ["github.com", "raw.githubusercontent.com"]
          }
        ]
      },
      "fs": {
        "all": false,
        "readText": true,
        "readBinary": true,
        "writeText": false,
        "writeBinary": true,
        "scope": [
          {
            "name": "App Data",
            "description": "Allows reading app data files",
            "paths": ["$APPDATA/Open Source Store", "$HOME/.open-source-store"]
          },
          {
            "name": "Download Folder",
            "description": "Allows saving downloaded APK files",
            "paths": ["$APPDATA/Open Source Store/downloads", "$HOME/.open-source-store/downloads"]
          }
        ]
      },
      "path": {
        "all": false,
        "scope": []
      },
      "dialog": {
        "all": true,
        "scope": []
      },
      "os": {
        "all": false,
        "scope": []
      },
      "clipboard": {
        "all": true
      },
      "notification": {
        "all": true
      }
    },
    "window": {
      "title": "Open Source Store",
      "width": 1280,
      "height": 720,
      "minWidth": 800,
      "minHeight": 600,
      "resizable": true,
      "fullscreen": false,
      "visible": true,
      "decorations": true,
      "center": true,
      "transparency": "none",
      "theme": "Dark"
    },
    "updater": {
      "active": false
    },
    "application": {
      "security": {
        "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: https:; connect-src 'self' https://github.com;"
      }
    },
    "build": {
      "beforeDevCommand": "",
      "beforeBuildCommand": "",
      "devPath": "web",
      "distDir": "dist",
      "withGlobalTauri": true
    },
    "plugins": {
      "shell": {
        "scripts": []
      }
    }
  }
}
