; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Open Source Store"
run/main_scene="res://scenes/store/main_store.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AppManager="*res://scripts/autoload/app_manager.gd"
DataManager="*res://scripts/autoload/data_manager.gd"
DownloadManager="*res://scripts/autoload/download_manager.gd"
ThemeManager="*res://scripts/autoload/theme_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

mouse_mode=MOUSE_MODE_VISIBLE

[rendering]

renderer/rendering_method="forward_plus"

[interface]

# Tema escuro por padrao
theme/default_font_color=Color(1, 1, 1, 1)
